{
  "name": "music-key-server",
  "version": "1.0.0",
  "description": "MusicKey Server",
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "core/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "build": "pkg . --output dist/music-key-server.exe",
    "clean": "node -e \"const fs=require('fs');['dist','logs','download','update','config.json','port.json'].forEach(f=>{try{fs.rmSync(f,{recursive:true,force:true})}catch(e){}});console.log('Cleaned (kept node_modules and node).')\""
  },
  "devDependencies": {
    "pkg": "latest"
  }
}
